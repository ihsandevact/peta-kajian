# Supabase Credentials (Wajib untuk Autentikasi & Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cron Security Secret (Otorisasi Trigger Endpoint Cron)
CRON_SECRET=your-cron-secret-token

# MapTiler (Opsional / Peta Kajian)
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-key

# Web Push Notification VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:dev.ihsan.act@gmail.com

# External APIs
GEMINI_API_KEY=your-gemini-api-key
YOUTUBE_API_KEY=your-youtube-api-key
